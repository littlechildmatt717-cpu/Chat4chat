rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Private details (full name, email, age): only the owner can read them.
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.age is int && request.resource.data.age >= 18;
    }

    // Public profile: username and photo only.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'photo']);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Lets people log in with their email. Stores a hash of the email, never the email itself.
    match /emailIndex/{h} {
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /messages/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['room','uid','name','photo','kind','text','url','ts'])
        && request.resource.data.name == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.username
        && request.resource.data.text.size() <= 1000;
      allow update, delete: if false;
    }

    match /dms/{pair} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create, update: if request.auth != null
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2
        && (pair == request.resource.data.members[0] + '_' + request.resource.data.members[1]
            || pair == request.resource.data.members[1] + '_' + request.resource.data.members[0]);
      match /messages/{id} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/dms/$(pair)).data.members;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text.size() <= 1000
          && request.auth.uid in getAfter(/databases/$(database)/documents/dms/$(pair)).data.members;
      }
    }

    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Reset codes and outgoing email are only touched by the server functions (no client access).
    match /resetCodes/{id} { allow read, write: if false; }
    match /mail/{id} { allow read, write: if false; }

    match /reports/{id} { allow create: if request.auth != null; }
  }
}
